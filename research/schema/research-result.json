{
  "$id": "https://caddy-beryl.vercel.app/research/schema/research-result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "topic": { "type": "string", "const": "housing" },
    "agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Which runner produced this, e.g. 'claude-code-routine', 'gemini-cli', 'ollama:llama3'"
    },
    "run_started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "When the research run started (ISO 8601 with timezone)"
    },
    "items": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Headline or a short factual title"
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri",
            "description": "Link to the original source. Used to de-duplicate items"
          },
          "source_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Publisher, e.g. 'Limerick City and County Council', 'The Irish Times'"
          },
          "source_type": {
            "type": "string",
            "enum": ["official", "news", "social", "provider", "unknown"],
            "description": "official = government, council, LDA, Housing Agency; provider = the AHB or landlord; social = social media (leads only)"
          },
          "published_on": {
            "anyOf": [
              { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              { "type": "null" }
            ],
            "description": "Date the source was published (YYYY-MM-DD), or null if not shown"
          },
          "summary": {
            "anyOf": [
              { "type": "string", "minLength": 1, "maxLength": 2000 },
              { "type": "null" }
            ],
            "description": "Two or three factual sentences from the source. No speculation"
          },
          "locality": {
            "anyOf": [
              { "type": "string", "minLength": 1, "maxLength": 120 },
              { "type": "null" }
            ],
            "description": "Town or area the item is about, e.g. 'Limerick City'"
          },
          "provider": {
            "anyOf": [
              { "type": "string", "minLength": 1, "maxLength": 200 },
              { "type": "null" }
            ],
            "description": "Housing provider named in the source, if any"
          },
          "cost_rental_confirmed": {
            "type": "string",
            "enum": ["yes", "no", "unconfirmed"],
            "description": "'yes' only when the source itself says the homes are Cost Rental"
          },
          "verification": {
            "type": "string",
            "enum": [
              "officially_confirmed",
              "corroborated",
              "reported",
              "unverified",
              "contradicted"
            ],
            "description": "officially_confirmed needs an official source; social posts are always unverified"
          }
        },
        "required": [
          "title",
          "url",
          "source_name",
          "source_type",
          "published_on",
          "summary",
          "locality",
          "provider",
          "cost_rental_confirmed",
          "verification"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["topic", "agent", "run_started_at", "items"],
  "additionalProperties": false,
  "description": "Caddy housing research result: Irish Cost Rental news from the last 30 days"
}
