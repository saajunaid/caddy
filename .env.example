# Copy to .env.local for local development. Never commit real values.

# Supabase (one project). The publishable key is safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only. Set in Vercel (Sensitive) and GitHub Actions secrets, never in the browser or this environment.
SUPABASE_SECRET_KEY=""

# App
APP_TIMEZONE="Europe/Dublin"
