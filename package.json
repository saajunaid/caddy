{
  "name": "caddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:local": "docker run -d --rm --name caddy-pg -e POSTGRES_PASSWORD=postgres -p 54329:5432 postgres:17",
    "db:types": "pnpm test:db && supabase gen types typescript --db-url \"postgresql://postgres:postgres@localhost:54329/caddy_test?sslmode=disable\" --schema public > src/lib/supabase/database.types.ts.tmp && (echo \"// Generated by \\`pnpm db:types\\` from the migrations. Do not edit by hand.\" && cat src/lib/supabase/database.types.ts.tmp) > src/lib/supabase/database.types.ts && rm src/lib/supabase/database.types.ts.tmp && prettier --write src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "cheerio": "1.2.0",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.2",
    "maplibre-gl": "6.12.0",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0"
}
